.settingsCard {
  color: var(--dsw-alias-label-primary);
  background: var(--dsw-alias-bg-module-platform);
  border: 1px solid var(--dsw-alias-border-l1);
  border-radius: 14px;
  padding: 18px;
  display: grid;
  gap: 10px;
}

/* Adapted from DSH 0.1.1-rc.2 AssistantMarkdown/ReasoningRow presentation. */
.assistant {
  color: var(--dsw-alias-label-primary);
  flex-direction: column;
  font-size: 16px;
  line-height: 28px;
  display: flex;
}

.assistantBody {
  flex-direction: column;
  gap: 16px;
  display: flex;
}

.assistantBody :global(.md-table-wide) {
  --dsh-table-spare: max(0px, calc((100cqw - var(--dsh-chat-content-width)) / 2));
  --dsh-table-lead: calc(var(--dsh-table-spare) + min(var(--dsh-chat-content-width), 100cqw) - 100%);
  box-sizing: border-box;
  width: calc(100% + var(--dsh-table-lead) + var(--dsh-table-spare));
  max-width: none;
  margin-left: calc(-1 * var(--dsh-table-lead));
  padding-left: var(--dsh-table-lead);
}

.stopped {
  background: var(--dsw-alias-interactive-bg-hover);
  color: var(--dsw-alias-label-tertiary);
  border-radius: 6px;
  align-self: flex-start;
  padding: 0 6px;
  font-size: 11px;
  line-height: 18px;
}

.visuallyHidden {
  clip: rect(0 0 0 0);
  white-space: nowrap;
  width: 1px;
  height: 1px;
  position: absolute;
  overflow: hidden;
}

.reasoningRoot {
  flex-direction: column;
  display: flex;
}

.reasoningRow {
  position: relative;
  overflow: hidden;
}

.reasoningRoot[data-state="running"] .reasoningRow::after {
  content: "";
  inset-block: 0;
  background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--dsw-alias-bg-base) 60%, transparent) 55%, transparent 100%);
  pointer-events: none;
  width: 300px;
  animation: 2.6s ease-out infinite reasoningRowSweep;
  position: absolute;
  left: 0;
}

@keyframes reasoningRowSweep {
  0% { left: -300px; }
  90%, to { left: 100%; }
}

.reasoningLeading { flex-shrink: 0; }
.reasoningChevron { color: var(--dsw-alias-label-secondary); }
.reasoningTitle { font-weight: 400; }
.reasoningSeparator {
  background: var(--dsw-alias-label-caption);
  border-radius: 1px;
  flex: none;
  width: 2px;
  height: 2px;
  margin: 0 8px;
}

.reasoningSummary {
  min-width: 0;
  color: var(--dsw-alias-label-tertiary);
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: auto;
  font-size: 14px;
  line-height: 24px;
  overflow: hidden;
}

.reasoningSummary[data-follow-end] { text-overflow: clip; }

.reasoningBody {
  color: var(--dsw-alias-label-tertiary);
  white-space: pre-wrap;
  word-break: break-word;
  padding: 4px 0 4px 22px;
  font-size: 14px;
  line-height: 24px;
}

.eyebrow {
  margin: 0;
  color: var(--dsw-alias-label-secondary);
  font-size: 11px;
  letter-spacing: .12em;
}

.title { margin: 0; font-size: 17px; }
.description { margin: 0 0 6px; color: var(--dsw-alias-label-secondary); line-height: 1.45; }
.label { display: grid; gap: 6px; font-size: 13px; font-weight: 600; }

.select,
.keyInput {
  color: inherit;
  background: var(--dsw-alias-bg-base);
  border: 1px solid var(--dsw-alias-border-l2);
  border-radius: 8px;
  min-height: 36px;
  padding: 0 10px;
}

.select:focus-visible,
.keyInput:focus-visible,
.action:focus-visible {
  outline: 2px solid var(--dsw-alias-label-primary-bluish);
  outline-offset: 2px;
}

.credentialStatus {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 5px 12px;
  margin: 4px 0;
  font-size: 12px;
}

.credentialStatus dt { color: var(--dsw-alias-label-secondary); }
.credentialStatus dd { margin: 0; }
.keyForm { display: grid; gap: 8px; }

.action {
  width: fit-content;
  border: 0;
  border-radius: 8px;
  min-height: 32px;
  padding: 0 12px;
  color: var(--dsw-alias-label-primary);
  background: var(--dsw-alias-button-info-fill);
  cursor: pointer;
}

.action:hover:not(:disabled) { filter: brightness(1.1); }
.action:disabled { opacity: .55; cursor: not-allowed; }
.actionSecondary {
  background: transparent;
  color: var(--dsw-alias-label-secondary);
  border: 1px solid var(--dsw-alias-border-l2);
}

.unavailable,
.feedback {
  margin: 0;
  color: var(--dsw-alias-label-secondary);
  font-size: 12px;
}

.player {
  display: grid;
  gap: 6px;
  width: min(100%, 360px);
  margin: 8px 0;
  padding: 10px;
  border: 1px solid var(--dsw-alias-border-l2);
  border-radius: 10px;
  background: var(--dsw-alias-bg-module-platform);
}

.playerLabel,
.preparing {
  color: var(--dsw-alias-label-secondary);
  font-size: 12px;
}

.player audio { width: 100%; height: 32px; }
.transcript { color: var(--dsw-alias-label-primary); white-space: pre-wrap; }
.error { color: var(--dsw-alias-label-secondary); font-size: 12px; }

@media (prefers-reduced-motion: reduce) {
  .reasoningRoot[data-state="running"] .reasoningRow::after { animation: none; }
}
